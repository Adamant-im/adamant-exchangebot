{
  /**
    The bot's ADAMANT passphrase.
    The bot's ADAMANT address and every other wallet it controls are derived from it,
    so treat this file as a hot wallet: never commit it and never share it.
  **/
  "passPhrase": "adamant wallet twelve words here",

  /**
    ADAMANT nodes to work with.
    The bot health-checks them and uses one that is live and at an actual blockchain height.
  **/
  "node_ADM": [
    "https://bid.adamant.im",
    "http://localhost:36666",
    "https://endless.adamant.im",
    "https://clown.adamant.im",
    "https://debate.adamant.im",
    "https://lake.adamant.im",
    "https://sunshine.adamant.im"
  ],

  /** Subscribe to new transactions over a socket. Recommended: it makes the bot answer instantly. **/
  "socket": true,

  /** Socket protocol, "ws" or "wss", depending on your server. **/
  "ws_type": "ws",

  /** Ethereum nodes, used for ETH and every ERC-20 token. **/
  "node_ETH": ["https://ethnode2.adamant.im", "https://ethnode3.adamant.im"],

  /** Dogecoin nodes. **/
  "node_DOGE": ["https://dogenode2.adamant.im", "https://dogenode3.adm.im"],

  /** Bitcoin nodes. **/
  "node_BTC": ["https://btcnode1.adamant.im", "https://btcnode3.adamant.im"],

  /** Dash nodes. **/
  "node_DASH": ["https://dashnode1.adamant.im", "https://dashnode2.adamant.im"],

  /** ADAMANT InfoServices, used for exchange rates. **/
  "infoservice": ["https://info.adamant.im", "https://info2.adm.im"],

  /** MongoDB connection string. **/
  "db_url": "mongodb://localhost:27017/",

  /** MongoDB database name. **/
  "db_name": "exchangerdb",

  /**
    Coins the bot accepts for exchange.
    A payment in any other coin is sent back.
  **/
  "accepted_crypto": ["ADM", "BTC", "ETH", "DASH", "DOGE", "USDT", "USDC", "DAI", "XCN"],

  /**
    Coins the bot pays out in.
    A request for any other coin is answered with a list of the coins it can pay out in.
  **/
  "exchange_crypto": ["ADM", "BTC", "ETH", "DASH", "DOGE", "USDT", "USDC", "DAI"],

  /**
    Every coin the bot has an adapter for.
    A coin missing from this list is not processed at all, and the operator is notified.
    Each coin here needs its node list above; ERC-20 tokens use "node_ETH".
  **/
  "known_crypto": ["ADM", "BTC", "ETH", "DASH", "DOGE", "USDT", "USDC", "DAI", "XCN"],

  /** Which of the known coins are ERC-20 tokens. Each must be described in helpers/cryptos/erc20_models.js. **/
  "erc20": ["USDT", "USDC", "DAI", "XCN"],

  /**
    External addresses used only to top up the bot's hot wallets.
    The list applies to every supported external coin: BTC, DASH, DOGE, ETH and ERC-20 tokens.
    ADAMANT transfers are not covered because their sender is verified by the ADAMANT transaction.
    A transfer from one of these senders is never settled as an exchange claim.
  **/
  "reserved_deposit_senders": [],

  /** Service fee, as a percentage. The user pays the blockchain Tx fees on top of it. **/
  "exchange_fee": 5,

  /**
    Service fee for a specific incoming coin, as a percentage.
    Overrides "exchange_fee". Set to false to use the general fee.
    Any coin from "known_crypto" can be used as the suffix.
  **/
  "exchange_fee_ADM": false,

  /** Minimum accepted payment, as a USD equivalent. Set to 0 to disable. **/
  "min_value_usd": 0,

  /** Daily exchange limit per user, as a USD equivalent. Set to 0 for no limit. **/
  "daily_limit_usd": 1000,

  /** Daily exchange limit for buying a specific coin. Set to 0 for no limit. **/
  "daily_limit_usd_ADM": 0,

  /** Show the limits in the /help reply. **/
  "daily_limit_show": true,

  /** Refuse to buy a coin above this price, in USD. Set to 0 to disable. **/
  "max_buy_price_usd_ADM": 0,

  /** Refuse to sell a coin below this price, in USD. Set to 0 to disable. **/
  "min_sell_price_usd_ADM": 0,

  /** Buy a coin at this fixed price, in USD, instead of the market rate. Set to 0 to use the market rate. **/
  "fixed_buy_price_usd_ADM": 0,

  /** Sell a coin at this fixed price, in USD, instead of the market rate. Set to 0 to use the market rate. **/
  "fixed_sell_price_usd_ADM": 0,

  /** Confirmations required before an incoming transfer is exchanged. **/
  "min_confirmations": 2,

  /** Confirmations required for a specific coin. Overrides "min_confirmations". **/
  "min_confirmations_ADM": 1,

  /** Reply sent the first time a user writes something the bot cannot interpret. **/
  "welcome_string": "Hi! 😊 I'm your exchange bot. I work instantly and anonymously. ℹ️ Learn more about me on ADAMANT’s blog, or type **/help** to see what I can do.",

  /** Name the bot uses in notifications. **/
  "bot_name": "Lovely Exchange Bot",

  /** ADAMANT address that receives operator notifications. Leave empty to disable. **/
  "adamant_notify": "",

  /** Slack incoming-webhook URL for operator notifications. Leave empty to disable. **/
  "slack": "",

  /**
    Logging verbosity, from quietest to most verbose:
    none < error < warn < info < log < debug < trace.
  **/
  "log_level": "log"
}
